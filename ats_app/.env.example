# ATS Application Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration
# ============================================================================
# Path to SQLite database file (default: ats_app/ats_data.db)
# DB_PATH=C:/path/to/custom/ats_data.db

# ============================================================================
# AI / LLM Configuration
# ============================================================================
# Anthropic API key for Claude AI features
ANTHROPIC_API_KEY=

# Claude model to use (default: claude-sonnet-4-5-20250929)
# AI_MODEL=claude-sonnet-4-5-20250929

# Maximum tokens for AI responses (default: 1024)
# AI_MAX_TOKENS=1024

# Timeout for AI API calls in seconds (default: 30.0)
# AI_TIMEOUT_SECONDS=30.0

# ============================================================================
# AWS Bedrock Configuration (alternative to direct Anthropic API)
# ============================================================================
# AWS region for Bedrock (default: us-east-1)
# AWS_REGION=us-east-1

# Bedrock model ID (default: anthropic.claude-sonnet-4-5-20250929-v1:0)
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Bedrock connection timeout in seconds (default: 10)
# BEDROCK_CONNECT_TIMEOUT=10

# Bedrock read timeout in seconds (default: 30)
# BEDROCK_READ_TIMEOUT=30

# ============================================================================
# Email / SMTP Configuration
# ============================================================================
# SMTP server hostname
SMTP_HOST=

# SMTP server port (default: 587 for TLS)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=

# SMTP password or app-specific password
SMTP_PASSWORD=

# From email address for sent emails
SMTP_FROM=

# SMTP timeout in seconds (default: 30)
# SMTP_TIMEOUT_SECONDS=30

# ============================================================================
# File Upload Configuration
# ============================================================================
# Directory for storing uploaded resumes (default: ats_app/uploads/resumes)
# UPLOAD_DIR=C:/path/to/custom/uploads

# Maximum resume file size in MB (default: 10.0)
# MAX_RESUME_SIZE_MB=10.0

# ============================================================================
# Session / Authentication Configuration
# ============================================================================
# Session timeout in hours (default: 2)
# SESSION_TIMEOUT_HOURS=2

# Scorecard token expiry in hours (default: 48)
# SCORECARD_TOKEN_EXPIRY_HOURS=48

# ============================================================================
# Webhook Configuration
# ============================================================================
# Timeout for webhook HTTP requests in seconds (default: 10)
# WEBHOOK_TIMEOUT_SECONDS=10
